# Public Supabase settings. Use the values from your Supabase project.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only Printify settings. Never add these to VITE_ variables.
PRINTIFY_API_KEY=your-printify-api-key
PRINTIFY_SHOP_ID=your-printify-shop-id

# Server-only Google Maps Platform key. Enable Places API (New).
GOOGLE_MAPS_API_KEY=your-server-only-google-maps-platform-key

